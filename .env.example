# Copy to .env. Leave keys empty to run fully offline (deterministic stand-ins).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# auto | anthropic | gemini | mock
SIGHTLINE_PROVIDER=auto

# Optional model routing (provider:model or bare model id)
# SIGHTLINE_MODEL_SMALL=claude-haiku-5-5
# SIGHTLINE_MODEL_LARGE=claude-opus-5-5
# SIGHTLINE_MODEL_MAPPER=gemini:gemini-2.5-flash

# Optional price for cost reporting, USD per 1M tokens "input,output"
# SIGHTLINE_PRICE_GEMINI_2_5_FLASH=

# Optional DuckDB location
# SIGHTLINE_DB=runs/sightline.duckdb
